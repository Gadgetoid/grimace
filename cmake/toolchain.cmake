set(CMAKE_SYSTEM_NAME Generic)

get_filename_component(GRIMACE_TOOLCHAIN_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

set(GRIMACE_ARCH mips CACHE STRING "Processor to target: mips, sh3, x86 or arm")
set_property(CACHE GRIMACE_ARCH PROPERTY STRINGS mips sh3 x86 arm)
if(GRIMACE_ARCH STREQUAL "arm")
    set(GRIMACE_DEFAULT_CE_VERSION 3)
else()
    set(GRIMACE_DEFAULT_CE_VERSION 1)
endif()
set(GRIMACE_CE_VERSION ${GRIMACE_DEFAULT_CE_VERSION} CACHE STRING "Windows CE version to target: 1, 1.01, 2 or 3")
set_property(CACHE GRIMACE_CE_VERSION PROPERTY STRINGS 1 1.01 2 3)
set(GRIMACE_PLATFORM "" CACHE STRING "Platform to target, e.g. hpc, hpc2000 or autopc: only its devices' export lists count. Empty for all")
set(GRIMACE_DEVICE "" CACHE STRING "Device to pin to, e.g. velo1, joyride or jornada720: import exactly what its ROM exports. Empty for any device")
if(GRIMACE_CE_VERSION STREQUAL "1.01")
    set(GRIMACE_WIN32_WCE 101)
else()
    set(GRIMACE_WIN32_WCE ${GRIMACE_CE_VERSION}00)
endif()

set(GRIMACE_RELEASE_FLAGS "-Os")
if(GRIMACE_ARCH STREQUAL "mips")
    set(CMAKE_SYSTEM_PROCESSOR mips)
    set(GRIMACE_TARGET mipsel-unknown-none-elf)
    set(GRIMACE_TARGET_FLAGS "-march=mips1 -msoft-float -mno-abicalls -fno-pic -G0 -mno-check-zero-division")
    set(GRIMACE_ARCH_DEFINES "")
    set(GRIMACE_LLVM_DESCRIPTION "LLVM install with the MIPS backend")
elseif(GRIMACE_ARCH STREQUAL "sh3")
    set(CMAKE_SYSTEM_PROCESSOR sh3)
    set(GRIMACE_TARGET sh3el-unknown-none-wince)
    set(GRIMACE_TARGET_FLAGS "-fno-pic")
    set(GRIMACE_ARCH_DEFINES SHx SH3 _SH3_)
    set(GRIMACE_LLVM_DESCRIPTION "LLVM install with the SuperH backend")
elseif(GRIMACE_ARCH STREQUAL "x86")
    set(CMAKE_SYSTEM_PROCESSOR i486)
    set(GRIMACE_TARGET i486-unknown-none-elf)
    set(GRIMACE_TARGET_FLAGS "-march=i486 -malign-double -freg-struct-return -fno-pic")
    set(GRIMACE_CXX_TARGET_FLAGS "-nostdinc++")
    set(GRIMACE_ARCH_DEFINES _X86_ x86 _M_IX86=400)
    set(GRIMACE_LLVM_DESCRIPTION "LLVM install with the X86 backend")
elseif(GRIMACE_ARCH STREQUAL "arm")
    set(CMAKE_SYSTEM_PROCESSOR arm)
    set(GRIMACE_TARGET armv4-unknown-none-wince)
    set(GRIMACE_TARGET_FLAGS "-mcpu=strongarm -marm -mfloat-abi=soft -fno-pic -fno-unwind-tables -fno-asynchronous-unwind-tables")
    set(GRIMACE_ARCH_DEFINES ARM _ARM_ ARMV4)
    set(GRIMACE_RELEASE_FLAGS "-Os -fomit-frame-pointer")
    set(GRIMACE_LLVM_DESCRIPTION "LLVM install with the armv4-unknown-none-wince target")
else()
    message(FATAL_ERROR "GRIMACE_ARCH must be mips, sh3, x86 or arm, not ${GRIMACE_ARCH}")
endif()

if(NOT GRIMACE_LLVM_ROOT)
    set(GRIMACE_LLVM_ROOT "$ENV{GRIMACE_LLVM_ROOT}")
endif()
if(NOT GRIMACE_LLVM_ROOT AND EXISTS "${GRIMACE_TOOLCHAIN_ROOT}/llvm/bin/clang")
    set(GRIMACE_LLVM_ROOT "${GRIMACE_TOOLCHAIN_ROOT}/llvm")
endif()
if(NOT GRIMACE_LLVM_ROOT)
    execute_process(COMMAND brew --prefix llvm OUTPUT_VARIABLE GRIMACE_BREW_LLVM OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(GRIMACE_BREW_LLVM)
        set(GRIMACE_LLVM_ROOT "${GRIMACE_BREW_LLVM}")
    else()
        find_program(GRIMACE_CLANG clang HINTS /opt/homebrew/opt/llvm/bin REQUIRED)
        get_filename_component(GRIMACE_CLANG_BIN "${GRIMACE_CLANG}" DIRECTORY)
        get_filename_component(GRIMACE_LLVM_ROOT "${GRIMACE_CLANG_BIN}" DIRECTORY)
    endif()
endif()
set(GRIMACE_LLVM_ROOT "${GRIMACE_LLVM_ROOT}" CACHE PATH "${GRIMACE_LLVM_DESCRIPTION}")

find_program(GRIMACE_LLD ld.lld HINTS "${GRIMACE_LLVM_ROOT}/bin" /opt/homebrew/opt/lld/bin REQUIRED)

set(CMAKE_C_COMPILER "${GRIMACE_LLVM_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${GRIMACE_LLVM_ROOT}/bin/clang++")
set(CMAKE_ASM_COMPILER "${GRIMACE_LLVM_ROOT}/bin/clang")
set(CMAKE_AR "${GRIMACE_LLVM_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${GRIMACE_LLVM_ROOT}/bin/llvm-ranlib")
set(CMAKE_LINKER "${GRIMACE_LLD}")
set(CMAKE_C_COMPILER_TARGET ${GRIMACE_TARGET})
set(CMAKE_CXX_COMPILER_TARGET ${GRIMACE_TARGET})
set(CMAKE_ASM_COMPILER_TARGET ${GRIMACE_TARGET})
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES GRIMACE_ARCH GRIMACE_CE_VERSION GRIMACE_PLATFORM GRIMACE_DEVICE GRIMACE_LLVM_ROOT)

set(CMAKE_C_FLAGS_INIT "${GRIMACE_TARGET_FLAGS} -fshort-wchar -ffreestanding -nostdlibinc -ffunction-sections -fdata-sections -D_WIN32_WCE=${GRIMACE_WIN32_WCE}")
if(GRIMACE_PLATFORM)
    string(TOUPPER "${GRIMACE_PLATFORM}" GRIMACE_PLATFORM_MACRO)
    list(APPEND GRIMACE_ARCH_DEFINES GRIMACE_PLATFORM=${GRIMACE_PLATFORM} GRIMACE_PLATFORM_${GRIMACE_PLATFORM_MACRO})
endif()
if(GRIMACE_DEVICE)
    string(TOUPPER "${GRIMACE_DEVICE}" GRIMACE_DEVICE_MACRO)
    list(APPEND GRIMACE_ARCH_DEFINES GRIMACE_DEVICE=${GRIMACE_DEVICE} GRIMACE_DEVICE_${GRIMACE_DEVICE_MACRO})
endif()
foreach(define IN LISTS GRIMACE_ARCH_DEFINES)
    string(APPEND CMAKE_C_FLAGS_INIT " -D${define}")
endforeach()
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} ${GRIMACE_CXX_TARGET_FLAGS} -std=c++20 -fno-exceptions -fno-rtti -fno-threadsafe-statics")
if(GRIMACE_WIN32_WCE GREATER_EQUAL 300 AND EXISTS "${GRIMACE_LLVM_ROOT}/include/c++/v1/__config" AND EXISTS "${GRIMACE_LLVM_ROOT}/share/libcxx/src/string.cpp")
    set(GRIMACE_LIBCXX ON)
    string(APPEND CMAKE_CXX_FLAGS_INIT " -nostdinc++")
else()
    set(GRIMACE_LIBCXX OFF)
endif()
set(CMAKE_ASM_FLAGS_INIT "${GRIMACE_TARGET_FLAGS}")
set(CMAKE_BUILD_TYPE_INIT MinSizeRel)
set(CMAKE_C_FLAGS_RELEASE_INIT "${GRIMACE_RELEASE_FLAGS}")
set(CMAKE_C_FLAGS_MINSIZEREL_INIT "${GRIMACE_RELEASE_FLAGS}")
set(CMAKE_CXX_FLAGS_RELEASE_INIT "${GRIMACE_RELEASE_FLAGS}")
set(CMAKE_CXX_FLAGS_MINSIZEREL_INIT "${GRIMACE_RELEASE_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static --emit-relocs --gc-sections")
set(CMAKE_C_LINK_EXECUTABLE "<CMAKE_LINKER> <LINK_FLAGS> <CMAKE_C_LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
set(CMAKE_CXX_LINK_EXECUTABLE "<CMAKE_LINKER> <LINK_FLAGS> <CMAKE_CXX_LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

if(GRIMACE_ARCH STREQUAL "mips")
    if(NOT DEFINED CMAKE_C_COMPILER_LAUNCHER)
        set(CMAKE_C_COMPILER_LAUNCHER "${GRIMACE_TOOLCHAIN_ROOT}/tools/grimace-cc")
        set(CMAKE_ASM_COMPILER_LAUNCHER "${GRIMACE_TOOLCHAIN_ROOT}/tools/grimace-cc")
    endif()
    if(NOT DEFINED CMAKE_CXX_COMPILER_LAUNCHER)
        set(CMAKE_CXX_COMPILER_LAUNCHER "${GRIMACE_TOOLCHAIN_ROOT}/tools/grimace-cc")
    endif()
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)

list(APPEND CMAKE_MODULE_PATH "${GRIMACE_TOOLCHAIN_ROOT}/cmake")
